# Server
PORT=8080
NODE_ENV=development
# SQLite for now; path is relative to server/. Replace with a hosted Postgres URL later.
DATABASE_URL=file:./data/inkwell.db
UPLOAD_DIR=./data/uploads
AUDIO_DIR=./data/audio
MAX_UPLOAD_MB=15
PIPELINE_VERSION=v1
DEMO_MODE=false

# Gemini (verify model IDs at https://ai.google.dev/gemini-api/docs/models)
GEMINI_API_KEY=
GEMINI_MODEL_TRANSCRIBE=gemini-3.8-flash
GEMINI_MODEL_TEXT=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Used when transcription with GEMINI_MODEL_TRANSCRIBE fails after retries. Pro has no free-tier quota.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# ElevenLabs
ELEVENLABS_API_KEY=
# "George - Warm, Captivating Storyteller" from the ElevenLabs default voice library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
